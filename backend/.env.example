# Copy this file to .env (or just export the variable in your shell) and
# point it at your MongoDB instance. Never commit the real .env file --
# it's already in .gitignore.

# Local MongoDB, default install (mongod running on the default port):
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=foodlens

# On Render: Render doesn't host MongoDB itself, so create a free cluster at
# https://www.mongodb.com/cloud/atlas, then paste its connection string
# (Atlas -> Connect -> Drivers) into MONGODB_URI as an environment variable
# on your web service -- no code changes needed. It looks like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"

# Optional: enables AI-written ingredient explanations. Leave blank to run
# in offline mode (a built-in ingredient table is used instead).
ANTHROPIC_API_KEY=
FOODLENS_AI=on
